# Required: replace every change-me value before deployment.
APP_NAME=MyAdNetwork
DOMAIN_NAME=ads.example.com
KCE_APP_URL=https://ads.example.com/kce
KCE_TRACKING_SECRET=change-me-use-a-long-random-secret

DB_DATABASE=myadnetwork
DB_USERNAME=myadnetwork
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-root-database-password

# Initial provider identity/contact. Empty values remain editable from admin.
PROVIDER_NAME=MyAdNetwork
PROVIDER_DOMAIN_URL=https://ads.example.com
PROVIDER_CONTACT_EMAIL=owner@example.com
PROVIDER_CONTACT_WHATSAPP=

# Transactional email through kirim.email.
SMTP_API_KEY=
SMTP_API_SECRET=

# Optional integrations.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
PAYMENT_INFO=
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
REPLICATE_API_KEY=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.70
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
