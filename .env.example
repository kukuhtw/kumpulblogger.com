DB_HOST="localhost"
DB_PORT="3306"
DB_USERNAME="your_database_user"
DB_PASSWORD="your_database_password"
DB_DATABASE="your_database_name"
DB_ROOT_PASSWORD="replace-with-a-local-root-password"

# Docker Compose / deployment identity
COMPOSE_PROJECT_NAME="myadnetwork"
APP_NAME="MyAdNetwork"
APP_BIND_ADDRESS="0.0.0.0"
APP_HTTP_PORT="8080"
DB_EXPOSED_PORT="127.0.0.1:3307"

# Transactional email provider: kirim.email (https://kirim.email/)
# Obtain the API credentials from your kirim.email account.
SMTP_API_KEY="your_kirim_email_api_key"
SMTP_API_SECRET="your_kirim_email_api_secret"
# Public AdNetwork domain (without scheme/path); authorize it in kirim.email.
DOMAIN_NAME="ads.example.com"
# Optional provider identity overrides. Leave empty to use APP_NAME/DOMAIN_NAME.
PROVIDER_NAME=""
PROVIDER_DOMAIN_URL=""
# Optional first-install seed values. Random provider keys are generated when empty.
PROVIDER_CODE=""
PROVIDER_HASH_KEY=""
PROVIDER_SECRET_KEY=""
PROVIDER_API_ENDPOINT=""
PROVIDER_CONTACT_EMAIL=""
PROVIDER_CONTACT_WHATSAPP=""
PROVIDER_ACCOUNT_NAME=""
PROVIDER_ACCOUNT_BANK=""
PROVIDER_ACCOUNT_NUMBER=""
RECAPTCHA_SITE_KEY="your_recaptcha_site_key"
RECAPTCHA_SECRET="your_recaptcha_secret"
PAYMENT_INFO="Payment instructions go here.\nUse {{ISIPESAN}} as the WhatsApp message placeholder."

# Knowledge Commerce Engine
LLM_MODEL="gpt-4.1-mini"
OPENAI_API_KEY=""
REPLICATE_API_KEY=""
LLM_MAX_TOKENS="2048"
LLM_TEMPERATURE="0.70"
OPENROUTER_API_KEY="sk-or-v1-your-key"
OPENROUTER_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"
NVIDIA_API_KEY="nvapi-your-key"
NVIDIA_EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
KCE_APP_URL="https://myadnetwork.example.com/kce"
KCE_TRACKING_SECRET="replace-with-a-long-random-secret"
